          "request": {
            "name": "Agromonitoring Get NDVI History",
            "description": {
              "content": "Returns historical NDVI (Normalized Difference Vegetation Index) data for a polygon over a specified date range. NDVI values range from -1 to 1, where values near 1 indicate dense green vegetation. Data is derived from Landsat 8 and Sentinel-2 satellite imagery.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "ndvi",
                "history"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "polyid",
                  "value": "<string>",
                  "description": "(Required) Polygon identifier."
                },
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<integer>",
                  "description": "(Required) Start date for NDVI history (Unix timestamp)."
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<integer>",
                  "description": "(Required) End date for NDVI history (Unix timestamp)."
                },
                {
                  "disabled": false,
                  "key": "appid",
                  "value": "<string>",
                  "description": "(Required) API key for authentication."
